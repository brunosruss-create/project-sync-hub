VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# Server-only (set via Lovable secrets):
# APP_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Opcional — sem isso, Sentry fica desligado (Sentry.init nunca é chamado):
# SENTRY_DSN=https://xxxx@oNNNN.ingest.sentry.io/NNNN

# ─── AI Content Generation Module ────────────────────────────────
# Chave do Gemini (texto E imagem) — configurada em global_settings.gemini_api_key
# pelo Super Admin em /super-admin/ia. NÃO precisa setar env var.
# (Variável abaixo é apenas fallback pra dev; produção usa o banco.)
# GEMINI_API_KEY=your-gemini-api-key
#
# Bancos de imagem — pelo menos 1 é obrigatório pra geração funcionar.
# PEXELS_API_KEY=your-pexels-api-key
# UNSPLASH_ACCESS_KEY=your-unsplash-access-key
# PIXABAY_API_KEY=your-pixabay-api-key
